# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (metadata, robots, sitemap). On Vercel it defaults to the production
# domain, so set it only for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres for Prisma (Project Settings -> Database -> Connection string)
# Transaction pooler, used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, used for migrations / db push
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Canvas sync: the Cloudflare Worker in tldraw-sync/ (cd tldraw-sync && pnpm exec wrangler deploy)
NEXT_PUBLIC_TLDRAW_SYNC_URL=https://outpost-tldraw-sync.<your-subdomain>.workers.dev
# Shared with the Worker (wrangler secret put CANVAS_SYNC_SECRET); e.g. openssl rand -base64 48
CANVAS_SYNC_SECRET=
# Required by tldraw in production (https://tldraw.dev/pricing); not needed on localhost
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Gemini, for the workspace agent
GEMINI_API_KEY=
